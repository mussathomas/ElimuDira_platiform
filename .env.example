# --- Supabase -----------------------------------------------------------
# Project Settings -> API in yhttps://your-project-ref.supabase.coour Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=postgresql://postgres:Kalidushi@98@db.rtqvfucndywhqshzfqgd.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only key; never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.rtqvfucndywhqshzfqgd:Kalidushi@98@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.rtqvfucndywhqshzfqgd:Kalidushi@98@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"
# --- Cloudflare R2 --------------------------------------------------------
# Cloudflare dashboard → R2 → Manage API tokens.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=elimudira-files

# Public hostname for the bucket (r2.dev subdomain, or a custom domain you've
# mapped to the bucket) — used only for Next/Image remote pattern matching.
NEXT_PUBLIC_R2_PUBLIC_HOSTNAME=your-bucket.r2.dev

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
